<!-- JavaScript to handle modal data population -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Get all video cards
    const videoCards = document.querySelectorAll('.video-card');

    // Add click event to each card
    videoCards.forEach(card => {
      card.addEventListener('click', async function(e) {
        // Get video ID from data attribute
        const videoId = this.getAttribute('data-video-id');
        const video = await getVideoData(videoId);

        if (!video || Object.keys(video).length === 0) return;

        // Populate modal with video data
        document.getElementById('modalVideoTitle').textContent = video.title;
        document.getElementById('modalVideoStatus').textContent = video.status;
        document.getElementById('modalVideoStatus').className = `badge rounded-pill ${getStatusClass(video.status)}`;
        document.getElementById('modalVideoViews').textContent = `${video.views} views`;
        document.getElementById('modalVideoDate').textContent = `Uploaded on ${video.created_at}`;
        document.getElementById('modalVideoDescription').textContent = video.description;
        <%# document.getElementById('modalCreatorName').textContent = video.creator.name;
        document.getElementById('modalCreatorInfo').textContent = video.creator.info;
        document.getElementById('modalCreatorAvatar').src = video.creator.avatar;
        document.getElementById('modalVideoCategory').textContent = video.category;
        document.getElementById('modalVideoDuration').textContent = video.duration;
        document.getElementById('modalVideoQuality').textContent = video.quality; %>

        // Set video source
        console.log(video.video_path)
        document.getElementById('modalVideoSource').src = video.video_path;

        const videoPlayer = document.getElementById('modalVideoPlayer');
        videoPlayer.load(); // Reload the video element

        // Clear and populate tags
        const tagsContainer = document.getElementById('modalVideoTags');
        tagsContainer.innerHTML = '';
        video.tags.forEach(tag => {
          const tagElement = document.createElement('span');
          tagElement.className = 'badge bg-light text-dark me-2 mb-2';
          tagElement.textContent = tag;
          tagsContainer.appendChild(tagElement);
        });
      });
    });

    // Helper function to get badge class based on status
    function getStatusClass(status) {
      switch(status) {
        case 'success': return 'bg-success';
        case 'pending': return 'bg-warning';
        case 'rejected': return 'bg-danger';
        default: return 'bg-secondary';
      }
    }

    // Updated getVideoData function
    async function getVideoData(id) {
      try {
        const response = await fetch(`/admins/video/${id}`);
        const data = await response.json();
        console.log(data);
        return data;
      } catch (error) {
        console.error("There was an error!", error);
        return {};
      }
    }

  });
</script>

<!-- Add custom styles for the video cards and section -->
<style>
  .video-signs-section {
    background-color: #f8f9fa;
  }
  
  .video-card {
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  
  .video-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }
</style>