<section class="video-signs-section py-5">
  <div class="container-fluid">
    <!-- Header and Toolbar -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
          <!-- Section Header -->
          <div class="mb-3 mb-md-0">
            <h2 class="fw-bold mb-0">Signs</h2>
            <p class="text-muted mb-0">Browse and manage your sign content</p>
          </div>
          
        </div>
        <hr class="my-3">
      </div>
    </div>

    <!-- Video Grid Layout -->
    <div class="row">
      <table id="signs-datatable" class="table table-hover py-3" data-source="<%= admins_signs_path(format: :json) %>">
        <thead>
          <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Description</th>
            <th>Status</th>
            <th>Created At</th>
            <th>Updated At</th>
            <th>Video ID</th>
          </tr>
        </thead>
        <tbody>
        </tbody>
      </table>
    </div>
    
  </div>
</section>

<script> 
  function loadTable() {
      var table = document.getElementById("signs-datatable");
      
      // Check if the DataTable is already initialized
      if ($.fn.DataTable.isDataTable(table)) {
          table.DataTable().destroy(); // Destroy the existing instance
          table.find('tbody').empty(); // Clear table content to prevent duplication
      }

      if (table) {
          $(table).DataTable({
          serverSide: true,
          ajax: {
              url: table.dataset.source,
              type: "GET"
          },
          columns: [
              { data: "id" },
              { data: "title" },
              { data: "description" },
              { data: "status" },
              { data: "created_at" },
              { data: "updated_at" },
              { data: "video_id" }
          ]
          });
      } else {
          console.error("Table with id 'signs-datatable' not found");
      }
  }
  document.addEventListener("turbo:load", loadTable);
</script>