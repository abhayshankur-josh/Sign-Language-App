<section class="vh-100" style="background-color:rgba(140, 140, 140, 0.25);">
  <div class="container h-100">
    <div class="row d-flex justify-content-center align-items-center h-100">
      <div class="col-xl-9">

        <h1 class="text-black mb-4">Submit a Video</h1>
        <%= form_with(url: create_submission_path, method: :post, id: "uploadform") do |form| %>
          <div class="card" style="border-radius: 15px;">
            <div class="card-body">
            
              <div class="row align-items-center pt-4 pb-3">
                <div class="col-md-3 ps-5">
                  <%= form.label :videoTitle, "Action title", class: "mb-0" %>
                </div>
                <div class="col-md-9 pe-5">
                  <%= form.text_field :videoTitle, class: "form-control form-control-lg", placeholder: "A Word defining the action", required: true%>
                </div>
              </div>
                 
              <hr class="mx-n3">
              
              <div class="row align-items-center py-3">
                <div class="col-md-3 ps-5">
                  <%= form.label :publisherEmail, "Email address", class: "mb-0" %>
                </div>
                <div class="col-md-9 pe-5">
                  <%= form.text_field :publisherEmail, value: @current_email, class: "form-control form-control-lg", readOnly: true %>
                </div>
              </div>
              
              <hr class="mx-n3">
              
              <div class="row align-items-center py-3">
                <div class="col-md-3 ps-5">
                  <%= form.label :videoDescription, "Action description", class: "mb-0" %>
                </div>
                <div class="col-md-9 pe-5">
                  <%= form.text_area :videoDescription, class: "form-control", rows: 3, placeholder: "An action describing the word or set of words.", required: true %>
                </div>
              </div>
              
              <hr class="mx-n3">
              
              <div class="row align-items-center py-3">
                <div class="col-md-3 ps-5">
                  <%= form.label :videoFile, "Upload Video", class: "mb-0" %>
                </div>
                <div class="col-md-9 pe-5">
                  <%= form.file_field :videoFile, class: "form-control form-control-lg", required: true %>
                  <div class="small text-muted mt-2">Upload the recorded action or any other relevant file. Max file size 10 MB</div>
                </div>
              </div>
              
              <hr class="mx-n3">

              <div class="row align-items-center py-3">
                <div class="col-md-3 ps-5">
                  <%= form.label :thumbnailFile, "Upload Thumbnail", class: "mb-0" %>
                </div>
                <div class="col-md-9 pe-5">
                  <%= form.file_field :thumbnailFile, class: "form-control form-control-lg" %>
                  <div class="small text-muted mt-2">Upload the relevant thumbnail. Max file size 5 MB</div>
                </div>
              </div>
              
              <hr class="mx-n3">
              
              <div class="px-5 py-4">
                <%= form.submit 'Submit', data: { mdb_button_init: true, mdb_ripple_init: true } , class: "btn btn-outline-success btn-lg" %>
              </div>
              
            </div>
          </div>
        <% end %>

      </div>
    </div>
  </div>
</section>

<script>
  // Reset the form when the page is reloaded
  window.addEventListener('load', function() {
    const form = document.getElementById('uploadform'); // Selects the form
    if (form) {
      form.reset(); // Resets all form fields to their default values
    }
  });
</script>
